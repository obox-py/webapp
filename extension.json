{
  "name": "webapp",
  "version": "1.0.0",
  "publisher": "chenzhi",
  "description": "网页应用：用 Chrome 应用模式打开站点，每条目独立 profile",
  "main": "extension.py",
  "icon": "main.svg",
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "app": {
      "id": "webapp.app",
      "title": "网页应用"
    },
    "configuration": {
      "properties": {
        "profileroot": {
          "type": "string",
          "title": "Profile 根目录",
          "default": "",
          "description": "留空表示扩展数据目录下的 profiles"
        },
        "limitmb": {
          "type": "enum",
          "title": "单站点数据上限",
          "enum": [
            "0",
            "512",
            "1024",
            "2048"
          ],
          "default": "2048",
          "description": "超过后拒绝打开并提示清理缓存"
        }
      }
    }
  }
}
